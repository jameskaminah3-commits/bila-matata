# Copy to .env for local development. Never commit real values.
# On Railway these go in the service's Variables; see DEPLOY.md.

# ── Required ──────────────────────────────────────────────────────────
PLATFORM_DATABASE_URL=postgres://postgres:postgres@127.0.0.1:5432/bilamatata_dev
SESSION_TOKEN_SECRET=change-me-to-48-or-more-random-characters-000000
# openssl rand -base64 32
PLATFORM_SECRETS_KEY=
GEMINI_API_KEY=

# ── The site ──────────────────────────────────────────────────────────
# The service's own address. Canonical links, invoice links, Paystack's
# return address and the studio's own Zaina all use it.
PUBLIC_BASE_URL=http://localhost:5070
PORT=5070
MIGRATE_ON_START=true

# ── /pay and Zaina's monthly plans: the studio's own Paystack account ──
# Start with the TEST key (sk_test_…). Use the live key only once Paystack
# has approved the account for what Bila Matata itself sells.
PLATFORM_PAYSTACK_SECRET_KEY=
# Optional: where the studio hears that an invoice was paid.
STUDIO_NOTIFY_EMAIL=

# ── Email (receipts, invoice links, password links, staff alerts) ─────
RESEND_API_KEY=
ALERT_FROM_EMAIL=

# ── First admin (created by the release step, then remove the password) ─
PLATFORM_ADMIN_EMAIL=
PLATFORM_ADMIN_PASSWORD=
PLATFORM_ADMIN_NAME=

# ── AI model (optional) ──────────────────────────────────────────────
# ZAINA_MODEL=gemini-3.5-flash-lite
# Near a business's daily budget (80% by default) the cheaper model answers instead.
# ZAINA_SAVER_MODEL=gemini-3.5-flash-lite
# ZAINA_SAVER_AT_PERCENT=80

# ── Local development and staging only ────────────────────────────────
# Extra websites allowed to embed every business's chat (comma-separated).
EXTRA_ALLOWED_ORIGINS=
